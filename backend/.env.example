# ==============================================================================
# B2B Supermarket - Backend Production Environment Variables
# Copy this file to .env and configure with your actual production credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000
# Listen on localhost only, so the API is reachable just through nginx
# (deployment/ecosystem.config.js sets this too). Leave unset in local dev.
HOST=127.0.0.1
# nginx sits in front — trust its X-Forwarded-For for client IPs (rate limits)
TRUST_PROXY=true
# Staging over HTTPS without NODE_ENV=production: still send cookies as Secure
# FORCE_SECURE_COOKIES=true

# PostgreSQL Database Connection URL (Managed Postgres e.g. Neon, Supabase, AWS RDS, or VPS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
#
# On Supabase specifically: use the POOLED connection string (Project Settings
# -> Database -> Connection string -> "Transaction" mode, port 6543), and
# append ?pgbouncer=true. PM2 runs this app in cluster mode (instances: 'max',
# see deployment/ecosystem.config.js) — several Node processes each with their
# own Prisma connection pool — so going through Supabase's pooler avoids
# exhausting its direct-connection limit.
DATABASE_URL="postgresql://supermarket_user:YOUR_STRONG_DB_PASSWORD@localhost:5432/supermarket_db?schema=public"

# Only needed for Supabase (or any provider where DATABASE_URL above points at
# a connection pooler): the DIRECT connection (port 5432, no pgbouncer),
# used only for schema changes (`npx prisma db push`). Leave unset if
# DATABASE_URL is already a direct (non-pooled) connection.
DIRECT_URL=

# Required secrets — left empty on purpose: the server refuses to start until
# they're set (a placeholder long enough to pass the length check would be a
# publicly known signing key). Generate each with: openssl rand -hex 32
# Signs admin/customer/driver session tokens.
JWT_SECRET=
# Signs the section-PIN unlock tokens. Must differ from JWT_SECRET.
SECTION_UNLOCK_SECRET=
# AES-256 key for customer/order personal data at rest (see README.md "Personal data & GDPR").
# Exactly 64 hex characters, required in production. Back it up: data
# encrypted with it can't be read without it.
ENCRYPTION_KEY=

# Public URL of your deployed Frontend (Used by CORS and email links). Several
# origins may be listed comma-separated for CORS; emails link to the first.
FRONTEND_URL="https://yourdomain.de"

# SMTP Email Configuration (For customer verification OTPs & order receipts)
# If using Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="orders@yourdomain.de"
EMAIL_PASSWORD="YOUR_SMTP_OR_APP_PASSWORD"
# Sender shown to customers (defaults to EMAIL_USER)
EMAIL_FROM=

# Recommended in production: shares rate-limit counters between the PM2
# workers — without it each worker counts separately (see README.md
# "4.3 Production environment").
REDIS_URL=redis://localhost:6379

# Optional: Web Push order-status notifications. Generate the key pair with:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@yourdomain.de

# WhatsApp Cloud API (Meta) for customer phone verification codes. See README §4.4.
# Unset in development: codes are logged to the console instead of sent.
# Unset in production: phone verification fails (customers can't order).
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Name of the approved "Authentication" template with a copy-code button.
# Required in production. Outside production codes are sent as plain text
# instead (needs a message from the recipient to your number in the last 24h).
WHATSAPP_OTP_TEMPLATE=
# Template language used when the customer's language (de/ar) isn't available.
WHATSAPP_TEMPLATE_DEFAULT_LANGUAGE=de
# Optional: Graph API version (default v23.0).
WHATSAPP_GRAPH_API_VERSION=

# Optional: controls the admin account created by `npm run prisma:seed`.
# If SEED_ADMIN_PASSWORD is left unset, a random one-time password is
# generated and printed to the console when you run the seed script instead.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: log every SQL query Prisma runs (very noisy). Off unless "true".
PRISMA_LOG_QUERIES=false

# Optional: the verified test customer created by `node scripts/createTestCustomer.js`.
# Unset values fall back to testcustomer@hajar.local / +436601234567 /
# "Test Customer" and a random password printed once.
TEST_CUSTOMER_EMAIL=
TEST_CUSTOMER_PHONE=
TEST_CUSTOMER_NAME=
TEST_CUSTOMER_PASSWORD=

# Backups (`npm run backup`, README §4.7). Uses DIRECT_URL. On a server,
# put BACKUP_DIR outside the web root, e.g. /var/backups/supermarket.
# Default: backups/ at the repo root (gitignored).
BACKUP_DIR=
# Keep every backup of the last N days, plus the newest of each of the last M months.
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=3
# Copies each new backup off the server; the file path is in $BACKUP_FILE.
# The copy must be encrypted, e.g. an rclone "crypt" remote:
#   BACKUP_COPY_COMMAND=rclone copy "$BACKUP_FILE" offsite-crypt:hajar-backups
BACKUP_COPY_COMMAND=
# Optional: Postgres server for `npm run backup:restore-test` (default: DIRECT_URL).
RESTORE_TEST_URL=
# Optional: folder with pg_dump/pg_restore/psql if they aren't on PATH.
PG_BIN_DIR=

# Optional: runs the database tests (tests/integration/) as part of npm test.
# A SEPARATE database whose name ends in _test: every test empties all
# tables. Created and set up automatically. README "Database tests".
TEST_DATABASE_URL=

# Optional: error tracking with Sentry (README §4.8). Off while empty. Use a
# project in Sentry's EU region (the DSN contains .de.sentry.io); setting it
# also shows the Sentry paragraph on /datenschutz.
SENTRY_DSN=
# Optional: environment name shown in Sentry (default: NODE_ENV).
SENTRY_ENVIRONMENT=
