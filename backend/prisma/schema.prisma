generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String    @id @default(uuid())
  nameDe        String
  nameAr        String
  descriptionDe String?
  descriptionAr String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id            String      @id @default(uuid())
  name          String
  nameDe        String?
  nameAr        String?
  description   String?
  descriptionDe String?
  descriptionAr String?
  sku           String      @unique
  b2bPrice      Float
  stock         Int         @default(0)
  imageUrl      String?
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  promotions    Promotion[]

  @@index([categoryId])
  @@index([stock])
}

model Customer {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  emailVerified        Boolean       @default(false)
  emailOtp             String?
  emailOtpExpiry       DateTime?
  phone                String        @unique
  phoneVerified        Boolean       @default(false)
  phoneOtp             String?
  phoneOtpExpiry       DateTime?
  password             String
  resetToken           String?
  resetTokenExpiry     DateTime?
  otpAttempts          Int           @default(0)
  street               String?
  houseNumber          String?
  postalCode           String?
  city                 String?
  floorApartment       String?
  deliveryNotes        String?
  preferredLanguage    String        @default("de")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  orders               Order[]
  couponUsages         CouponUsage[]
}

model Order {
  id                  String      @id @default(uuid())
  customerId          String?
  customer            Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  deliveryAddress     String?
  deliveryNotes       String?
  deliverySlot        String?
  paymentMethod       String      @default("cash_on_delivery")
  status              String      @default("pending")
  itemsSubtotal       Float       @default(0)
  couponId            String?
  coupon              Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?
  couponDiscount      Float       @default(0)
  promotionDiscount   Float       @default(0)
  isFreeShipping      Boolean     @default(false)
  totalAmount         Float
  originalTotalAmount Float?
  modificationReason  String?
  notes               String?
  adminNotes          String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]
  accounting          Accounting?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([couponCode])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  price           Float
  originalPrice   Float?
  discountAmount  Float    @default(0)
  promotionType   String?
  subtotal        Float

  @@index([orderId])
  @@index([productId])
}

model Accounting {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  type            String   @default("sale")
  amount          Float
  status          String   @default("completed")
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([transactionDate])
}

model StoreSettings {
  id                String   @id @default("default")
  storeName         String   @default("Hajar Supermarkt")
  storeNameDe       String   @default("Hajar Supermarkt")
  storeNameAr       String   @default("سوبرماركت هاجر")
  logoUrl           String?
  phone             String?  @default("+49 123 4567890")
  email             String?  @default("info@hajar-supermarkt.de")
  address           String?  @default("Musterstraße 123, 10115 Berlin")
  mapUrl            String?  @default("https://maps.google.com")
  mapEmbedUrl       String?
  googleReviewsUrl  String?  @default("https://search.google.com/local/reviews")
  googleRating      Float    @default(5.0)
  googleReviewCount Int      @default(120)
  googlePlaceId     String?
  googleApiKey      String?
  trustindexWidgetCode String?
  showGoogleReviews Boolean  @default(true)
  minOrderValue         Float    @default(0)
  deliveryFee           Float    @default(0)
  freeDeliveryThreshold Float    @default(0)
  allowedPostalCodes    String?  @default("")
  updatedAt         DateTime @updatedAt
}

model GoogleReview {
  id             String   @id @default(uuid())
  authorName     String
  authorPhotoUrl String?
  rating         Int      @default(5)
  relativeTime   String   @default("vor 1 Woche")
  text           String
  textDe         String?
  textAr         String?
  reviewUrl      String?
  verified       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Coupon {
  id                    String        @id @default(uuid())
  code                  String        @unique
  description           String?
  discountType          String        // "PERCENTAGE", "FIXED", "COMBO"
  discountValue         Float         // e.g. 10 for 10% or 5 for €5
  freeShipping          Boolean       @default(false)
  requiredProductIds    String?       // comma-separated product IDs required for bundle combo
  minOrderValue         Float         @default(0)
  maxDiscountAmount     Float?        // optional cap for percentage discounts
  startDate             DateTime?
  endDate               DateTime?
  usageLimit            Int?          // total max uses across all users, null = unlimited
  usageLimitPerCustomer Int           @default(1)
  usedCount             Int           @default(0)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  orders                Order[]
  usages                CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String
  usedAt     DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, customerId])
}

model Promotion {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  titleDe          String
  titleAr          String?
  type             String    // "PRODUCT_DISCOUNT", "BUY_X_GET_Y"
  discountPercent  Float?    // e.g. 20 for 20% off
  promotionalPrice Float?    // e.g. 2.99
  buyQuantity      Int?      @default(2) // for 2+1: buy 2
  getYQuantity     Int?      @default(1) // for 2+1: get 1 free
  badgeTextDe      String?   // e.g. "2+1 Gratis", "Angebot -20%"
  badgeTextAr      String?   // e.g. "2+1 مجاناً"
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId])
  @@index([isActive])
}


