generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  tokenVersion       Int       @default(0)
  // Login 2FA: a code emailed on every login, checked before the session JWT is issued.
  twoFactorOtp       String?
  twoFactorOtpExpiry DateTime?
  twoFactorAttempts  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Tracks admin access to customer records (view/export), for accountability.
model AuditLog {
  id         String   @id @default(uuid())
  adminEmail String
  action     String // e.g. 'VIEW_CUSTOMERS', 'EXPORT_ACCOUNTING'
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Category {
  id            String    @id @default(uuid())
  nameDe        String
  nameAr        String
  descriptionDe String?
  descriptionAr String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Product {
  id            String      @id @default(uuid())
  name          String
  nameDe        String?
  nameAr        String?
  description   String?
  descriptionDe String?
  descriptionAr String?
  sku           String      @unique
  b2bPrice      Float
  stock         Int         @default(0)
  imageUrl      String?
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  promotions    Promotion[]

  @@index([categoryId])
  @@index([stock])
}

model Customer {
  id                String             @id @default(uuid())
  name              String
  // email/phone are encrypted at rest (see utils/piiCrypto.js); emailHash/
  // phoneHash are deterministic SHA-256 hashes used for exact-match lookups
  // (login, uniqueness checks) since the ciphertext itself isn't comparable.
  email             String
  emailHash         String             @unique
  emailVerified     Boolean            @default(false)
  emailOtp          String?
  emailOtpExpiry    DateTime?
  phone             String
  phoneHash         String             @unique
  phoneVerified     Boolean            @default(false)
  phoneOtp          String?
  phoneOtpExpiry    DateTime?
  password          String
  resetToken        String?
  resetTokenExpiry  DateTime?
  otpAttempts       Int                @default(0)
  tokenVersion      Int                @default(0)
  street            String?
  houseNumber       String?
  postalCode        String?
  city              String?
  floorApartment    String?
  deliveryNotes     String?
  preferredLanguage String             @default("de")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  couponUsages      CouponUsage[]
  pushSubscriptions PushSubscription[]
}

// A browser's Web Push subscription (one per browser/device that granted
// notification permission) — used to push order-status updates even when
// the site isn't open. endpoint is the subscription's unique push URL.
model PushSubscription {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model Order {
  id                  String      @id @default(uuid())
  customerId          String?
  customer            Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName        String?
  customerPhone       String?
  customerEmail       String?
  deliveryAddress     String?
  deliveryNotes       String?
  deliverySlot        String?
  paymentMethod       String      @default("cash_on_delivery")
  status              String      @default("pending")
  itemsSubtotal       Float       @default(0)
  couponId            String?
  coupon              Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?
  couponDiscount      Float       @default(0)
  promotionDiscount   Float       @default(0)
  isFreeShipping      Boolean     @default(false)
  deliveryFee         Float       @default(0)
  deliveryDistanceKm  Float?
  baseDeliveryFee     Float?
  distanceDeliveryFee Float?
  totalAmount         Float
  originalTotalAmount Float?
  modificationReason  String?
  notes               String?
  adminNotes          String?
  // Which driver an admin has picked to deliver this order. A name, not a
  // foreign key — drivers aren't persistent accounts (see DriverSession),
  // so this is just a label the admin sets and both the admin's Orders
  // page and the driver's own delivery view can display.
  assignedDriverName  String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  orderItems          OrderItem[]
  accounting          Accounting?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([couponCode])
  @@index([assignedDriverName])
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  price          Float
  originalPrice  Float?
  discountAmount Float   @default(0)
  promotionType  String?
  subtotal       Float

  @@index([orderId])
  @@index([productId])
}

model Accounting {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type            String   @default("sale")
  amount          Float
  status          String   @default("completed")
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([transactionDate])
}

model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("Hajar Supermarkt")
  storeNameDe           String   @default("Hajar Supermarkt")
  storeNameAr           String   @default("سوبرماركت هاجر")
  logoUrl               String?
  phone                 String?  @default("+49 123 4567890")
  email                 String?  @default("info@hajar-supermarkt.de")
  address               String?  @default("Musterstraße 123, 10115 Berlin")
  mapUrl                String?  @default("https://maps.google.com")
  mapEmbedUrl           String?
  googleReviewsUrl      String?  @default("https://search.google.com/local/reviews")
  googleRating          Float    @default(5.0)
  googleReviewCount     Int      @default(120)
  googlePlaceId         String?
  googleApiKey          String?
  trustindexWidgetCode  String?
  showGoogleReviews     Boolean  @default(true)
  minOrderValue         Float    @default(0)
  deliveryFee           Float    @default(2.0)
  deliveryFeePerKm      Float    @default(0.10)
  freeDeliveryThreshold Float    @default(0)
  storeLatitude         Float?   @default(48.1746605)
  storeLongitude        Float?   @default(16.3272662)
  maxDeliveryDistanceKm Float?   @default(0)
  allowedPostalCodes    String?  @default("")
  // Legal identity fields shown on the Impressum & AGB pages (Austrian
  // e-commerce law requires the actual responsible person, not just the
  // trade name) — edited via Settings -> Rechtliches so they don't need a
  // code change.
  legalOwnerName        String?
  gisaNumber            String?
  isKleinunternehmer    Boolean  @default(true)
  vatId                 String?
  businessPurposeDe     String?  @default("Groß- und Einzelhandel mit Lebensmitteln und orientalischen Spezialitäten")
  businessPurposeAr     String?  @default("تجارة الجملة والتجزئة للمواد الغذائية والمنتجات الاستهلاكية")
  // Hashed step-up PIN gating access to the Settings, Accounting, Customers
  // and Promotions admin pages (a shop-terminal deterrent, not a separate
  // privilege boundary — there is only one Admin account). Never sent to the
  // frontend; only a verify endpoint compares against it.
  sectionPasscodeHash   String?
  updatedAt             DateTime @updatedAt
}

// A registered delivery driver with their own PIN — replaces the old
// single Fahrer-PIN shared by every courier. Driver.name is the stable
// identity used everywhere a driver is referenced (DriverLoginRequest,
// DriverSession, Order.assignedDriverName), so renaming a driver here
// only affects future assignments; past orders keep the name that was
// assigned at the time, the same snapshot approach already used for
// Order.customerName elsewhere in this schema.
model Driver {
  id        String   @id @default(uuid())
  name      String   @unique
  pinHash   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// A driver who knows their own correct PIN still can't get a session on
// their own — this row exists so an admin has to explicitly approve the
// login from the dashboard first (stops a leaked/guessed PIN alone from
// granting delivery-portal access unattended). pollToken is the opaque
// value the driver's browser polls with; the JWT itself is only ever
// handed out once status flips to "approved".
model DriverLoginRequest {
  id          String    @id @default(uuid())
  driverName  String
  pollToken   String    @unique
  status      String    @default("pending") // pending | approved | rejected
  // Requester's IP — an extra sanity-check signal for the admin approving
  // the request, not proof by itself.
  ipAddress   String?
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  respondedBy String?

  @@index([status, createdAt])
}

// One row per approved driver login. The JWT alone can't be revoked once
// handed out (it's just a signed token), so driverOrAdminAuthMiddleware
// checks this row on every request instead of trusting the JWT signature
// alone — that's what lets an admin actually force a driver logged out
// from the dashboard before their 24h token would otherwise expire.
model DriverSession {
  id         String    @id @default(uuid())
  driverName String
  jti        String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([revokedAt, expiresAt])
}

// Admin-configurable delivery time windows offered to customers at checkout
// (e.g. "10-12", "16-18"). Order.deliverySlot encodes the chosen window's
// hours directly (e.g. "2026-09-25_10_12"), not a foreign key to this table,
// so past orders keep a stable, readable time even if a window is later
// edited or removed.
model DeliveryWindow {
  id        String   @id @default(uuid())
  startHour Int
  endHour   Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startHour, endHour])
}

model GoogleReview {
  id             String   @id @default(uuid())
  authorName     String
  authorPhotoUrl String?
  rating         Int      @default(5)
  relativeTime   String   @default("vor 1 Woche")
  text           String
  textDe         String?
  textAr         String?
  reviewUrl      String?
  verified       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Coupon {
  id                    String        @id @default(uuid())
  code                  String        @unique
  description           String?
  discountType          String // "PERCENTAGE", "FIXED", "COMBO"
  discountValue         Float // e.g. 10 for 10% or 5 for €5
  freeShipping          Boolean       @default(false)
  requiredProductIds    String? // comma-separated product IDs required for bundle combo
  minOrderValue         Float         @default(0)
  maxDiscountAmount     Float? // optional cap for percentage discounts
  startDate             DateTime?
  endDate               DateTime?
  usageLimit            Int? // total max uses across all users, null = unlimited
  usageLimitPerCustomer Int           @default(1)
  usedCount             Int           @default(0)
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  orders                Order[]
  usages                CouponUsage[]

  @@index([code])
  @@index([isActive])
}

model CouponUsage {
  id         String   @id @default(uuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String
  usedAt     DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, customerId])
}

model Promotion {
  id               String    @id @default(uuid())
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  titleDe          String
  titleAr          String?
  type             String // "PRODUCT_DISCOUNT", "BUY_X_GET_Y"
  discountPercent  Float? // e.g. 20 for 20% off
  promotionalPrice Float? // e.g. 2.99
  buyQuantity      Int?      @default(2) // for 2+1: buy 2
  getYQuantity     Int?      @default(1) // for 2+1: get 1 free
  badgeTextDe      String? // e.g. "2+1 Gratis", "Angebot -20%"
  badgeTextAr      String? // e.g. "2+1 مجاناً"
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([productId])
  @@index([isActive])
}
