# ==============================================================================
# B2B Supermarket - Frontend Production Environment Variables
# ==============================================================================

# Public Backend API URL
# If hosting frontend and backend under the same domain (e.g. Nginx proxying /api to port 5000), leave this empty or relative.
# If hosting backend on a separate subdomain (e.g. https://api.yourdomain.de), specify it here:
VITE_API_URL=

# Firebase Web App config (Phone Auth for customer phone verification)
# From Firebase Console -> Project Settings -> General -> Your apps -> Web app.
# These are not secret; they identify the project (protection comes from Firebase's
# own security rules / API key restrictions), so it's safe to commit an .env with
# real values here if your deploy process does so.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
